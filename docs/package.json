{
  "name": "graviton-docs",
  "type": "module",
  "private": true,
  "scripts": {
    "docs:dev": "vitepress dev .",
    "docs:check-mermaid": "node scripts/check-mermaid.mjs",
    "docs:build": "npm run docs:check-mermaid && vitepress build .",
    "docs:preview": "vitepress preview .",
    "docs:build-full": "cd .. && npm ci --prefix docs && ./sbt buildDocsAssets && npm run docs:build --prefix docs"
  },
  "devDependencies": {
    "@noble/hashes": "^2.4.0",
    "mermaid": "^11.17.2",
    "pako": "^3.0.1",
    "vitepress": "^1.2.2",
    "vitepress-plugin-mermaid": "^2.0.16"
  },
  "overrides": {
    "vite": "6.4.3"
  }
}
