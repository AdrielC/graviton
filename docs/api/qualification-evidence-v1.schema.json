{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graviton.dev/schema/production-qualification-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "commit", "workingTreeClean", "endpoint", "startedAt", "completedAt", "evidence"],
  "properties": {
    "schema": {"const": "graviton-production-qualification-v1"},
    "status": {"enum": ["passed", "failed"]},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
    "workingTreeClean": {"const": true},
    "endpoint": {"type": "string", "format": "uri"},
    "startedAt": {"type": "string", "format": "date-time"},
    "completedAt": {"type": "string", "format": "date-time"},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
