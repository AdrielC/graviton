    {
      "type": "stat", "title": "Healthy erasure targets", "id": 3,
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"min": 0, "max": 3, "thresholds": {"mode": "absolute", "steps": [{"color": "red"}, {"color": "orange", "value": 2}, {"color": "green", "value": 3}]}}, "overrides": []},
