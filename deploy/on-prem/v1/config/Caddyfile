# Court-pilot gateway.
#
# Terminates TLS, forwards client IP + User-Agent, and routes:
#   /api/*       → graviton-node-1  (authenticated upload / download)
#   /dev/token   → graviton-node-1  (HS256 mint — pilot only; disable in prod)
#   /api/health  → graviton-node-1  (public liveness)
#   /            → quasar-api       (everything else: docs UI, metadata)
#
# Production notes:
#   1. Replace `{$GRAVITON_ACME_EMAIL}` + `{$GRAVITON_PUBLIC_HOST}` via the
#      .env file. Caddy will auto-provision Let's Encrypt certs if the
#      public host resolves to this server's public IP.
#   2. For an air-gapped court network, comment out the `tls {...}` block
#      below and supply your own cert via `tls /etc/caddy/cert.pem
#      /etc/caddy/key.pem`.
#   3. `/dev/token` MUST be removed from this config once OIDC is wired.

{
  email {$GRAVITON_ACME_EMAIL}
}

{$GRAVITON_PUBLIC_HOST} {
  encode zstd gzip

  # Security headers — baseline for a legal-DMS front door.
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options    "nosniff"
    X-Frame-Options           "DENY"
    Referrer-Policy           "no-referrer"
    Permissions-Policy        "camera=(), microphone=(), geolocation=()"
    -Server
  }

  # Public liveness — no auth, no logging of body.
  @health path /api/health
  handle @health {
    reverse_proxy graviton-node-1:{$GRAVITON_HTTP_PORT}
  }

  # Graviton API: requires Authorization: Bearer <jwt> (enforced by
  # graviton-security AuthMiddleware, not here).
  @graviton path /api/blobs* /api/stats /api/schema /api/datalake*
  handle @graviton {
    reverse_proxy graviton-node-1:{$GRAVITON_HTTP_PORT} {
      header_up X-Forwarded-For   {remote}
      header_up X-Forwarded-Proto {scheme}
    }
  }

  # HS256 dev mint endpoint — pilot only. Drop this handle() block once
  # your IdP is live and GRAVITON_SECURITY_DEV_SHARED_SECRET is unset.
  @devMint path /dev/token
  handle @devMint {
    reverse_proxy graviton-node-1:{$GRAVITON_HTTP_PORT}
  }

  # Everything else hits the Quasar metadata API.
  handle {
    reverse_proxy quasar-api:{$QUASAR_HTTP_PORT}
  }

  # Access log: JSON-lines for SIEM ingestion.
  log {
    output stdout
    format json
  }
}

# Redirect plain HTTP to HTTPS.
:80 {
  redir https://{$GRAVITON_PUBLIC_HOST}{uri} permanent
}
