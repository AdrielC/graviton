# =========================================================================
# Graviton court-pilot environment template.
#
# Copy to `.env` next to docker-compose.yml and edit every value marked
# REQUIRED before `docker compose up`. All `CHANGE-ME-*` values MUST be
# replaced with values from your secrets manager; defaults are placeholders
# that will refuse to start in production-mode.
# =========================================================================

# ---- Graviton server --------------------------------------------------
GRAVITON_HTTP_PORT=8081
GRAVITON_GRPC_PORT=9090
GRAVITON_BLOB_BACKEND=s3

# ---- Postgres ---------------------------------------------------------
# REQUIRED. The superuser password bootstraps the DB on first start only;
# afterwards Graviton connects as quasar_app (NOBYPASSRLS).
POSTGRES_DB=quasar
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERPASS=CHANGE-ME-STRONG-SUPERUSER-PASSWORD
POSTGRES_PORT=5432
# App role used at runtime. Created by 00_roles.sql; keep in sync there.
PG_USERNAME=quasar_app
PG_PASSWORD=CHANGE-ME-STRONG-APP-PASSWORD
PG_JDBC_URL=jdbc:postgresql://postgres:5432/quasar

# ---- MinIO (blob object store) ---------------------------------------
MINIO_ROOT_USER=minio-admin
MINIO_ROOT_PASSWORD=CHANGE-ME-MINIO-ROOT
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
QUASAR_MINIO_URL=http://minio:9000
GRAVITON_S3_BLOCK_BUCKET=graviton-blocks
GRAVITON_S3_BLOCK_PREFIX=cas/blocks
GRAVITON_S3_BUCKET=graviton-blobs
GRAVITON_S3_TMP_BUCKET=graviton-tmp

# ---- Security ---------------------------------------------------------
# Required to run at all with auth on. Leave ENABLED=true for a court
# pilot; setting to false exposes the API unauthenticated.
GRAVITON_SECURITY_ENABLED=true
# These match the `iss` and `aud` claims your tokens MUST carry. For a
# court pilot, pick a human-friendly label; for production, use your
# IdP's issuer URL (e.g. https://auth.yourcourt.gov/realms/graviton).
GRAVITON_SECURITY_OIDC_ISSUER=graviton-court-pilot
GRAVITON_SECURITY_OIDC_AUDIENCE=graviton

# ---- JWT mode ---------------------------------------------------------
# Pick exactly one:
#
# (A) PILOT: set a strong shared secret here. Graviton exposes POST
#     /dev/token so the operator can mint short-lived HS256 tokens for
#     staff. Convenient; not suitable for > pilot scale. REPLACE before
#     going to production.
#
# (B) PRODUCTION: leave EMPTY and wire an OIDC/JWKS verifier at assembly
#     time. See docs/guide/secure-api-quickstart.md § 2 for the
#     RS256 + JWKS flow.
GRAVITON_SECURITY_DEV_SHARED_SECRET=CHANGE-ME-AT-LEAST-32-CHARS-RANDOM

# ---- Audit -----------------------------------------------------------
# `jdbc` = persistent hash-chained audit log in quasar.audit_log (court
# posture). `memory` = ephemeral, tests only.
GRAVITON_SECURITY_AUDIT_BACKEND=jdbc

# ---- Transport / rate limits -----------------------------------------
# require-tls=true forbids plain-HTTP listeners. The Caddy gateway does
# the TLS termination and forwards in-cluster over the internal network.
GRAVITON_SECURITY_REQUIRE_TLS=true
GRAVITON_SECURITY_RATE_LIMIT_PER_PRINCIPAL_PER_SEC=100
GRAVITON_SECURITY_MAX_REQUEST_BYTES=5368709120
GRAVITON_SECURITY_CLOCK_SKEW_SECONDS=30

# ---- Gateway (Caddy) --------------------------------------------------
# Public hostname the court will hit. MUST have a real DNS record
# pointing at this host for Caddy to auto-provision a Let's Encrypt cert,
# OR supply your own cert via ./config/certs/ and edit the Caddyfile.
GRAVITON_PUBLIC_HOST=graviton.court.example.gov
# Email used for ACME cert registration.
GRAVITON_ACME_EMAIL=ops@court.example.gov

# ---- Initial seed (consumed by bootstrap-court.sh only) ---------------
# REQUIRED for the bootstrap script to mint the first admin JWT.
COURT_ADMIN_ORG_ID=00000000-0000-0000-0000-000000000001
COURT_ADMIN_PRINCIPAL_ID=00000000-0000-0000-0000-000000000002
COURT_ADMIN_DISPLAY_NAME="Court IT Admin"
