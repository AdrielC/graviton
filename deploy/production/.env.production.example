# Copy only for manual review. `./operator.sh init` creates the real mode-0600 file.
GRAVITON_IMAGE=ghcr.io/adrielc/graviton@sha256:REPLACE_WITH_RELEASE_DIGEST
GRAVITON_RELEASE_VERSION=0.6.1
GRAVITON_MAINTENANCE_NAMESPACE=graviton-production
GRAVITON_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
GRAVITON_S3_ACCESS_KEY=graviton
GRAVITON_S3_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
GRAVITON_SHARDCAKE_INTERNAL_TOKEN=REPLACE_WITH_32_TO_256_SAFE_CHARACTERS
GRAVITON_SECURITY_OIDC_ISSUER=https://identity.example.com/
GRAVITON_SECURITY_OIDC_AUDIENCE=graviton
GRAVITON_SECURITY_OIDC_JWKS_URI=https://identity.example.com/.well-known/jwks.json
GRAVITON_SECURITY_CORS_ALLOWED_ORIGINS=https://console.example.com
GRAVITON_SECURITY_AUTHORIZATION_BACKEND=token
GRAVITON_BIND_ADDRESS=127.0.0.1
GRAVITON_NODE1_HTTP_PORT=8081
GRAVITON_NODE2_HTTP_PORT=8082
GRAVITON_NODE1_GRPC_PORT=9090
GRAVITON_NODE2_GRPC_PORT=9091
GRAVITON_BACKUP_ROOT=./backups
